{"nodes": [{"id": "docs_contexto_funil_fitsync", "label": "FitSync", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI-driven workout and diet consultancy delivered directly through WhatsApp; one-liner 'Seu consultor de treino e dieta, direto no bolso.'"}, {"id": "docs_contexto_funil_sync_coach", "label": "Sync (AI Coach)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persona: direct, friendly, motivating without flattery; talks like a personal trainer on WhatsApp, no formal 'Prezado' or long walls of text. Understands intent via real function calling over user data, not a menu chatbot."}, {"id": "docs_contexto_funil_whatsapp_interface", "label": "WhatsApp as Interface", "file_type": "rationale", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Differentiator #1: WhatsApp is the interface, zero app to open, zero friction. Users log meals/workouts by message or photo in PT-BR."}, {"id": "docs_contexto_funil_meal_photo_analysis", "label": "Meal Photo Analysis", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI identifies foods in a photo of a plate and logs calories/macros automatically."}, {"id": "docs_contexto_funil_function_calling", "label": "Coach Function Calling (8 tools)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Differentiator #2: coach understands intent via real function calling over the user's actual data; reads what the person ate today and answers with real numbers. 8 tools with conversation memory."}, {"id": "docs_contexto_funil_web_app", "label": "FitSync Web App (mobile-first)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complete mobile-first web app: daily dashboard 'Hoje', workouts with sets/loads/PR tracking, diet with macro goals, progress charts, AI workout and meal-plan generators."}, {"id": "docs_contexto_funil_workout_generator", "label": "AI Workout Generator", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates workouts using methods like PPL, Upper/Lower, ABC."}, {"id": "docs_contexto_funil_meal_plan_generator", "label": "AI Meal Plan Generator", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates 3 variations per meal matching the target calories."}, {"id": "docs_contexto_funil_tdee_macros", "label": "TDEE & Macros Onboarding", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal onboarding (weight, height, objective, activity) calculates TDEE and macros."}, {"id": "docs_contexto_funil_target_audience", "label": "Target Audience (BR lifters 20-40)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brazilians who train (mainly bodybuilding), aged 20-40, use WhatsApp all day, abandoned MyFitnessPal/spreadsheets, can't afford personal+nutritionist (R$300-800/mo). Pains: inconsistency, not knowing if eating right, lack of accountability."}, {"id": "docs_contexto_funil_positioning", "label": "Positioning & Differentiators", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beats MyFitnessPal/FatSecret (manual, English, no coach), personal+nutri (R$300-800/mo vs R$29,90), spreadsheets (no intelligence), workout-only apps like Mfit (no diet/conversation)."}, {"id": "docs_contexto_funil_business_model", "label": "Business Model", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subscription with automatic recurring billing; no permanent free plan."}, {"id": "docs_contexto_funil_plano_mensal", "label": "Plano Mensal (R$29,90/m\u00eas)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contexto_funil_plano_anual", "label": "Plano Anual (R$257/ano)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "R$257/year (~R$21,42/mo), marketed as 'Economize 28%'."}, {"id": "docs_contexto_funil_trial_first", "label": "Trial-First (7 days, no card)", "file_type": "rationale", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "7-day free trial on both plans with no upfront card; first invoice only due on day 7. No permanent free plan because AI cost per user > 0, so trial-first rather than freemium. If trial->paid < 10% after ~100 trials, test a 'reverse trial' (limited no-AI mode instead of full block)."}, {"id": "docs_contexto_funil_subscription_states", "label": "Subscription States", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TRIALING (7 days) -> ACTIVE (paid) / PAST_DUE (invoice overdue) -> CANCELED. Updated automatically by Asaas webhook."}, {"id": "docs_contexto_funil_subscription_enforced", "label": "SUBSCRIPTION_ENFORCED Flag", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subscription-block flag exists but is currently OFF until the Asaas account is activated."}, {"id": "docs_contexto_funil_sales_funnel", "label": "Sales Funnel", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ad/organic -> Landing -> 'Testar gr\u00e1tis 7 dias' -> /login signup -> goal onboarding -> app unlocked -> Settings/Subscription choose plan + CPF -> Asaas checkout -> WhatsApp linking -> uses coach. Must cover acquisition (top), landing/activation (middle), trial->paid conversion + PAST_DUE recovery via PIX (bottom), and retention."}, {"id": "docs_contexto_funil_landing_page", "label": "Landing Page", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark PT-BR landing: hero with phone mockups, features section, 'como funciona' with WhatsApp conversation mockup, plans (Monthly/Annual), final CTA. Hosted at fit-sync-eight-zeta.vercel.app."}, {"id": "docs_contexto_funil_whatsapp_linking", "label": "WhatsApp Linking (FIT-XXXXXX)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App generates a FIT-XXXXXX code; user sends it to the bot to link the number, with ownership verification by code."}, {"id": "docs_contexto_funil_activation_metric", "label": "Activation Metric #1", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "% of accounts that link WhatsApp and make their first log on day 1; target >50%. Healthy trial->paid: 15-25% without upfront card."}, {"id": "docs_contexto_funil_meta_ads", "label": "Meta Ads Acquisition", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Priority acquisition channel; needs creative angles, audiences, offer, considering Brazil CPM/CPC and the R$29,90 ticket."}, {"id": "docs_contexto_funil_asaas", "label": "Asaas (payment gateway)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brazilian gateway; hosted checkout offers PIX, boleto or card. Code integrated but account not yet activated (missing keys), so nobody can pay yet."}, {"id": "docs_contexto_funil_asaas_webhook", "label": "Asaas Webhook", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Updates subscription state automatically; validated with signature/token."}, {"id": "docs_contexto_funil_supabase", "label": "Supabase (auth/DB)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handles email/password signup; only transactional email today is the Supabase confirmation email."}, {"id": "docs_contexto_funil_nextjs_16", "label": "Next.js 16", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contexto_funil_prisma", "label": "Prisma", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contexto_funil_openai", "label": "OpenAI (GPT-4.1-mini / GPT-4o)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GPT-4.1-mini powers the coach; GPT-4o powers the generators."}, {"id": "docs_contexto_funil_meta_whatsapp_cloud_api", "label": "Meta WhatsApp Cloud API", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Official WhatsApp number registered with Meta Cloud API (Phone ID active)."}, {"id": "docs_contexto_funil_vercel", "label": "Vercel (hosting)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contexto_funil_rate_limit", "label": "Coach Rate Limit (60 msgs/day)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_contexto_funil_security_audit", "label": "Security Hardening", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audited: IDOR fixed, webhooks with signature/token validation, number-ownership verification by code."}, {"id": "docs_contexto_funil_error_monitoring", "label": "Error Monitoring (Discord)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real-time error alerting via optional Discord webhook."}, {"id": "docs_contexto_funil_meta_business_verification", "label": "Meta Business Verification (pending)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocked by lack of CNPJ; without it the bot cannot initiate conversations (no proactive messages/templates), so trial-end reminders and re-engagement over WhatsApp are impossible - notices must be in-app or email. Plan: open a MEI when revenue arrives."}, {"id": "docs_contexto_funil_lgpd", "label": "LGPD Legal Blocker", "file_type": "rationale", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No terms of use / privacy policy yet; collecting CPF, phone and health data makes this a legal blocker before paid traffic."}, {"id": "docs_contexto_funil_brand_identity", "label": "Brand Identity", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Green #1D9E75, Inter font, informal-direct tone ('Bora', 'fechou')."}, {"id": "docs_contexto_funil_economic_kpis", "label": "Economic KPIs (CAC/LTV/payback)", "file_type": "concept", "source_file": "docs/CONTEXTO_FUNIL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Target CAC, estimated LTV (R$29,90 subscription, churn TBD), payback."}], "edges": [{"source": "docs_contexto_funil_fitsync", "target": "docs_contexto_funil_sync_coach", "rela