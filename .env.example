NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
OPENAI_API_KEY=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_PROFESSIONAL_TEMPLATE_NAME=professional_followup_pt_br
# número do bot (só dígitos, ex: 5511963122174) — usado no link wa.me da vinculação
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=

# Asaas (cobrança recorrente)
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# token que você define ao cadastrar o webhook no painel do Asaas
ASAAS_WEBHOOK_TOKEN=
# 'true' para exigir assinatura ativa para usar o app (padrão: desligado)
SUBSCRIPTION_ENFORCED=false

# Admin — e-mails com acesso ao painel /app/admin (separados por vírgula)
ADMIN_EMAILS=
PROFESSIONAL_PORTAL_ENABLED=false
PROFESSIONAL_OWNER_EMAILS=

# URL pública do app (usada em links de e-mail)
NEXT_PUBLIC_APP_URL=

# Resend (e-mails transacionais). Sem a chave, e-mails viram no-op.
RESEND_API_KEY=
# remetente verificado no Resend, ex: FitSync <contato@seudominio.com.br>
EMAIL_FROM=

# Monitoramento — webhook de alertas em tempo real (Discord/Slack). Opcional.
MONITORING_WEBHOOK_URL=
# Rate limit do coach (padrões: 60/dia, 8/min). Opcional.
COACH_DAILY_MSG_LIMIT=60
COACH_BURST_MSG_LIMIT=8
